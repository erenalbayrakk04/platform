        /* Yukleme ekrani: oyunla ayni oranda kutu, oyunun ilk gokyuzu renkleriyle (settings.SKY_THEMES);
           ortada donen altin, "Yukleniyor" yazisi ve indirme cubugu. Oyun ilk karesini cizince kaybolur */
        #loader {
